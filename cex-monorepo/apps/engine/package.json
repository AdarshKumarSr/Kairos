{
  "name": "@cex/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "engine:verify": "tsx src/cli/verify.ts",
    "engine:snapshot-now": "tsx src/cli/snapshot-now.ts"
  },
  "dependencies": {
    "@cex/config": "0.1.0",
    "@cex/logger": "0.1.0",
    "@cex/money": "0.1.0",
    "@cex/types": "0.1.0",
    "ioredis": "^5.4.2"
  }
}
